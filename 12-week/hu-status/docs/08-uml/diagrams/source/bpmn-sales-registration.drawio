<?xml version="1.0" encoding="UTF-8"?><mxfile host="app.diagrams.net" agent="SynkroTech documentation" version="26.0"><diagram id="bpmn-sales-registration" name="BPMN — Sale registration and uncertain recovery"><mxGraphModel dx="1950" dy="1120" grid="1" gridSize="10" page="1" pageWidth="1950" pageHeight="1120"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="BPMN — Sale registration and uncertain recovery" style="text;html=0;fontSize=26;fontStyle=1;fontFamily=Segoe UI;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1870" height="40" as="geometry"/></mxCell><mxCell id="subtitle" value="Accepted ADR-015/016 · one original intent identity · no blanket 4xx compensation or automatic restart promise" style="text;html=0;fontSize=15;fontFamily=Segoe UI;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="65" width="1870" height="40" as="geometry"/></mxCell><mxCell id="uilane" value="Browser: Sales Portal uses Host session/client; owns per-tab journal and bounded observation" style="swimlane;horizontal=1;startSize=30;whiteSpace=wrap;html=0;fillColor=#f8fafc;strokeColor=#cbd5e1;fontFamily=Segoe UI;fontSize=16;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="115" width="1870" height="210" as="geometry"/></mxCell><mxCell id="sagalane" value="Workflow: person authority at entry, SERVICE authority to real participants, own durable store" style="swimlane;horizontal=1;startSize=30;whiteSpace=wrap;html=0;fillColor=#f8fafc;strokeColor=#cbd5e1;fontFamily=Segoe UI;fontSize=16;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="355" width="1870" height="340" as="geometry"/></mxCell><mxCell id="resultlane" value="Evidence/outcome handling — each projection has a distinct UI/operational consequence" style="swimlane;horizontal=1;startSize=30;whiteSpace=wrap;html=0;fillColor=#f8fafc;strokeColor=#cbd5e1;fontFamily=Segoe UI;fontSize=16;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="735" width="1870" height="240" as="geometry"/></mxCell><mxCell id="input" value="Select Customer + Product IDs/qty&#xa;Preview only; persist original key,&#xa;fingerprint and 24h deadline" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8efff;strokeColor=#405979;fontFamily=Segoe UI;fontSize=16;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="90" y="165" width="430" height="120" as="geometry"/></mxCell><mxCell id="post" value="Explicit POST /sagas/register-sale&#xa;No automatic POST retry&#xa;RUNNING -&gt; bounded observation" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8efff;strokeColor=#405979;fontFamily=Segoe UI;fontSize=16;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="650" y="165" width="450" height="120" as="geometry"/></mxCell><mxCell id="replay" value="Validate caller/input replay&#xa;Persist state/attempt identity" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8efff;strokeColor=#405979;fontFamily=Segoe UI;fontSize=16;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="90" y="420" width="340" height="125" as="geometry"/></mxCell><mxCell id="reserve" value="1 validate Customer&#xa;2 reserve all stock atomically&#xa;Freeze prices in Products" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8efff;strokeColor=#405979;fontFamily=Segoe UI;fontSize=16;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="500" y="420" width="350" height="125" as="geometry"/></mxCell><mxCell id="register" value="3 register Sale in Sales&#xa;Frozen prices + createdBy&#xa;Sales computes integer totals" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8efff;strokeColor=#405979;fontFamily=Segoe UI;fontSize=16;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="920" y="420" width="350" height="125" as="geometry"/></mxCell><mxCell id="evidence" value="Validated&#xa;outcome?" style="rhombus;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#405979;fontFamily=Segoe UI;fontSize=16;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1370" y="395" width="230" height="175" as="geometry"/></mxCell><mxCell id="complete" value="COMPLETED + saleId&#xa;Load authoritative Sale/history&#xa;Metadata failure keeps IDs/amounts" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8efff;strokeColor=#405979;fontFamily=Segoe UI;fontSize=16;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1370" y="805" width="430" height="120" as="geometry"/></mxCell><mxCell id="compensate" value="Proven permitted rejection&#xa;Release only an existing reservation&#xa;COMPENSATED, or FAILED if release cannot complete" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8efff;strokeColor=#405979;fontFamily=Segoe UI;fontSize=16;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="500" y="800" width="680" height="130" as="geometry"/></mxCell><mxCell id="hold" value="Ambiguous / possibly committed&#xa;Retain stock and original identity&#xa;RUNNING/suspended or attention; reconcile" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff7ed;strokeColor=#405979;fontFamily=Segoe UI;fontSize=16;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="90" y="590" width="760" height="90" as="geometry"/></mxCell><mxCell id="note" value="Unresolved is a browser observation state, not proof of backend failure. Reload does not auto-POST/GET; explicit same-key recovery only. Logout/abort does not cancel or compensate a saga. FAILED requires attention; no fresh key to conceal uncertainty." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff7ed;strokeColor=#405979;fontFamily=Segoe UI;fontSize=16;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="80" y="1000" width="1790" height="90" as="geometry"/></mxCell><mxCell id="edge-0" value="" style="noEdgeStyle=1;html=0;rounded=0;endArrow=block;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#405979;fontSize=13;fontFamily=Segoe UI;" edge="1" parent="1" source="input" target="post"><mxGeometry relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell><mxCell id="edge-1" value="Original person/key/input" style="noEdgeStyle=1;html=0;rounded=0;endArrow=block;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeColor=#405979;fontSize=13;fontFamily=Segoe UI;" edge="1" parent="1" source="post" target="replay"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="875" y="352.5"/><mxPoint x="260" y="352.5"/></Array></mxGeometry></mxCell><mxCell id="edge-2" value="" style="noEdgeStyle=1;html=0;rounded=0;endArrow=block;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#405979;fontSize=13;fontFamily=Segoe UI;" edge="1" parent="1" source="replay" target="reserve"><mxGeometry relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell><mxCell id="edge-3" value="Step 3" style="noEdgeStyle=1;html=0;rounded=0;endArrow=block;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#405979;fontSize=13;fontFamily=Segoe UI;" edge="1" parent="1" source="reserve" target="register"><mxGeometry relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell><mxCell id="edge-4" value="" style="noEdgeStyle=1;html=0;rounded=0;endArrow=block;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#405979;fontSize=13;fontFamily=Segoe UI;" edge="1" parent="1" source="register" target="evidence"><mxGeometry relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell><mxCell id="edge-5" value="Confirmed receipt" style="noEdgeStyle=1;html=0;rounded=0;endArrow=block;exitX=1;exitY=0.49714285714285716;entryX=0.5;entryY=0;strokeColor=#405979;fontSize=13;fontFamily=Segoe UI;" edge="1" parent="1" source="evidence" target="complete"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1810" y="482"/><mxPoint x="1810" y="750"/><mxPoint x="1585" y="750"/></Array></mxGeometry></mxCell><mxCell id="edge-6" value="Proven rejection" style="noEdgeStyle=1;html=0;rounded=0;endArrow=block;exitX=0.25;exitY=0.75;entryX=0.7647058823529411;entryY=0;strokeColor=#405979;fontSize=13;fontFamily=Segoe UI;" edge="1" parent="1" source="evidence" target="compensate"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1290" y="600"/><mxPoint x="1290" y="765"/><mxPoint x="1020" y="765"/></Array></mxGeometry></mxCell><mxCell id="edge-7" value="Unknown / invalid evidence" style="noEdgeStyle=1;html=0;rounded=0;endArrow=block;exitX=0.5;exitY=1;entryX=1;entryY=0.5;strokeColor=#405979;fontSize=13;fontFamily=Segoe UI;" edge="1" parent="1" source="evidence" target="hold"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1485" y="635"/></Array></mxGeometry></mxCell><mxCell id="edge-8" value="Proven pre-sale rejection" style="noEdgeStyle=1;html=0;rounded=0;endArrow=block;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeColor=#405979;fontSize=13;fontFamily=Segoe UI;" edge="1" parent="1" source="reserve" target="compensate"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="675" y="575"/><mxPoint x="1220" y="575"/><mxPoint x="1220" y="720"/><mxPoint x="840" y="720"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>
