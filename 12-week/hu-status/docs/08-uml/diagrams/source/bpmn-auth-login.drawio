<?xml version="1.0" encoding="UTF-8"?><mxfile host="app.diagrams.net" agent="SynkroTech documentation" version="26.0"><diagram id="bpmn-auth-login" name="BPMN — Real Auth Login"><mxGraphModel dx="1700" dy="950" grid="1" gridSize="10" page="1" pageWidth="1700" pageHeight="950"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="BPMN — Real Auth Login" style="text;html=0;fontSize=26;fontStyle=1;fontFamily=Segoe UI;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1620" height="40" as="geometry"/></mxCell><mxCell id="subtitle" value="Auth portal collects; Host owns authentication/session; Gateway limits/presence routing; Auth issues credentials" style="text;html=0;fontSize=15;fontFamily=Segoe UI;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="65" width="1620" height="40" as="geometry"/></mxCell><mxCell id="browser" value="Browser: Auth portal and Host capability" style="swimlane;horizontal=1;startSize=30;whiteSpace=wrap;html=0;fillColor=#f8fafc;strokeColor=#cbd5e1;fontFamily=Segoe UI;fontSize=16;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="115" width="1620" height="220" as="geometry"/></mxCell><mxCell id="authlane" value="Gateway / Auth API: separate transport and identity responsibilities" style="swimlane;horizontal=1;startSize=30;whiteSpace=wrap;html=0;fillColor=#f8fafc;strokeColor=#cbd5e1;fontFamily=Segoe UI;fontSize=16;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="365" width="1620" height="390" as="geometry"/></mxCell><mxCell id="start" value="Start" style="ellipse;whiteSpace=wrap;html=0;fillColor=#e8efff;strokeColor=#405979;fontFamily=Segoe UI;fontSize=16;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="70" y="190" width="58" height="58" as="geometry"/></mxCell><mxCell id="form" value="Auth Login form&#xa;Email/password, pending/errors" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8efff;strokeColor=#405979;fontFamily=Segoe UI;fontSize=16;strokeWidth=2;" vertex="1" parent="1">