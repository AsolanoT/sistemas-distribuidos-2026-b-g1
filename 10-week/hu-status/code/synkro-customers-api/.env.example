# No real values belong in this file or in any committed .env file.
SERVER_PORT=8080
SPRING_DATASOURCE_URL=jdbc:postgresql://synkro-db:5432/synkro?currentSchema=customers_schema
# Optional URL sslmode=disable/prefer/require/verify-ca/verify-full.
# Mount trusted PostgreSQL certificates when verification is enabled.
# URL may reduce connectTimeout/loginTimeout/socketTimeout to positive 1..3/5/10s;
# duplicate/unknown parameters, embedded credentials or other schemas are rejected.
SPRING_DATASOURCE_USERNAME=customers_app
# Supply exactly the restricted application password through protected environment
# or a readable mounted secret. A configured file wins and fails if invalid/empty.
SPRING_DATASOURCE_PASSWORD=
SPRING_DATASOURCE_PASSWORD_FILE=
# Auth X.509 PUBLIC KEY PEM (RSA >=2048); literal escaped newlines are accepted.
# A configured file wins. Never mount the Auth private key here.
JWT_PUBLIC_KEY=
JWT_PUBLIC_KEY_FILE=/run/secrets/jwt_public_key
# Host path, only for deploy/compose.secrets.yml; paths must be outside this repo.
CUSTOMERS_APP_PASSWORD_FILE=
JWT_PUBLIC_KEY_HOST_FILE=
PLATFORM_NETWORK=platform
# Fixed runtime settings, no environment override: pool 10; acquire 5s;
# connect/login/socket 3/5/10s; statement 5s; transaction 10s; shutdown 20s.
# SQL init and Flyway are disabled. No Hibernate/JPA dependency exists.
# TEST_DATABASE_URL, TEST_DATABASE_PASSWORD and TEST_ADMIN_PASSWORD are fixture-only
# values generated by tests/verify.mjs; never configure these in production.
