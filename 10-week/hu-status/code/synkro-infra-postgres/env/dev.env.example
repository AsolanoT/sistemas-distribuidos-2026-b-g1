# Absolute secret paths; files are never versioned. Restrict to owner access
# (chmod 600 on Linux; owner-only ACLs on Windows).
COMPOSE_PROJECT_NAME=synkro-dev
DB_ADMIN_USER=postgres
DB_ADMIN_PASSWORD_PATH=/absolute/protected/dev/postgres-admin-password
AUTH_APP_PASSWORD_PATH=/absolute/protected/dev/auth-app-password
CUSTOMERS_APP_PASSWORD_PATH=/absolute/protected/dev/customers-app-password
PRODUCTS_APP_PASSWORD_PATH=/absolute/protected/dev/products-app-password
WORKFLOW_APP_PASSWORD_PATH=/absolute/protected/dev/workflow-app-password
JWT_PRIVATE_KEY_PATH=/absolute/protected/dev/private.pem
JWT_PUBLIC_KEY_PATH=/absolute/protected/dev/public.pem
JWT_PUBLIC_KEY=REPLACE_WITH_PUBLIC_PEM_AS_REQUIRED_BY_DELIVERED_GO_APIS
SPRING_DATASOURCE_URL=jdbc:postgresql://synkro-db:5432/synkro?currentSchema=auth_schema
DATABASE_URL=REPLACE_WITH_PRODUCTS_APP_CONNECTION_URI_ONLY
SALES_APP_MONGODB_URI=REPLACE_WITH_COMPLETE_SALES_APP_URI_AUTH_SOURCE_ADMIN_RS0_BOUNDED_TIMEOUTS
# Sales application limits; the migration runner has its separate options.
MONGODB_TIMEOUT=5s
MONGODB_MAX_POOL_SIZE=10
MONGODB_DATABASE=sales
MONGODB_OPTIONS=authSource=admin&replicaSet=rs0&connectTimeoutMS=5000&serverSelectionTimeoutMS=10000
# Published Mongo owning-repository contract; the root derives migration MONGODB_URI in memory.
MONGO_ADMIN_USER=<set-administrator-name>
MONGO_ADMIN_PASSWORD=<set-distinct-administrator-secret>
SALES_APP_PASSWORD=<set-distinct-sales-app-secret>
MONGO_INTERNAL_KEY=<set-base64-internal-key>
MONGO_NETWORK=platform
MONGO_REPLICA_SET=rs0
MONGO_STARTUP_TIMEOUT_SECONDS=60
MONGO_CONNECT_TIMEOUT_MS=2000
MONGODB_NETWORK=platform
WORKFLOW_SERVICE_TOKEN=REPLACE_WITH_AUTH_ISSUED_WORKFLOW_TOKEN
WORKER_SERVICE_TOKEN=REPLACE_WITH_AUTH_ISSUED_WORKER_TOKEN
CORS_ALLOWED_ORIGINS=http://localhost:5173
RATE_LIMIT_PER_SECOND=20
VITE_API_BASE_URL=http://localhost:8000
VITE_DEV_SIGN_IN=false
VITE_PRODUCTS_PORTAL_ENTRY=http://localhost:5173/remotes/products/assets/remoteEntry.js
VITE_SHELL_ENTRY_URL=http://localhost:5173/assets/remoteEntry.js
HOST_ORIGIN=http://localhost:5173
GRAFANA_ADMIN_USER=REPLACE_WITH_GRAFANA_ADMIN_USER
GRAFANA_ADMIN_PASSWORD_PATH=/absolute/protected/dev/grafana-password
BACKUP_DIRECTORY=/absolute/protected/backups

# Approved Workflow: restricted app datasource; migrations remain explicit tooling.
WORKFLOW_DATABASE_URL=jdbc:postgresql://synkro-db:5432/synkro?connectTimeout=3&socketTimeout=10
WORKFLOW_EXECUTORS=4
WORKFLOW_QUEUE=64
WORKFLOW_RESPONSE_TIMEOUT_MS=1000

# Approved Auth/Customers: independent restricted application datasource files.
AUTH_DATABASE_URL=jdbc:postgresql://synkro-db:5432/synkro?currentSchema=auth_schema&connectTimeout=5&socketTimeout=60
CUSTOMERS_DATABASE_URL=jdbc:postgresql://synkro-db:5432/synkro?currentSchema=customers_schema&connectTimeout=5&socketTimeout=60
VITE_AUTH_PORTAL_ENTRY=http://localhost:5173/remotes/auth/assets/remoteEntry.js
VITE_CUSTOMERS_PORTAL_ENTRY=/remotes/customers/remoteEntry.js
