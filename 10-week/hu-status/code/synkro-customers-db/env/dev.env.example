# Copy to env/dev.env (or qa/main); never commit actual environment files.
COMPOSE_PROJECT_NAME=synkro-dev
PLATFORM_NETWORK=platform
# Published HU-INF-02 target, not an automatically selected database.
FLYWAY_URL=jdbc:postgresql://synkro-db:5432/synkro?connectTimeout=5&socketTimeout=60
FLYWAY_USER=postgres
# Root orchestration supplies the password in memory. Never put it in arguments.
FLYWAY_PASSWORD=
# Container path, only if infrastructure mounts an existing secret explicitly.
FLYWAY_PASSWORD_FILE=
# Optional file override deploy/compose.secrets.yml: absolute protected HOST path.
CUSTOMERS_DB_ADMIN_PASSWORD_FILE=
# Legacy URL/user fallbacks, used only when the corresponding FLYWAY value is empty.
CUSTOMERS_FLYWAY_URL=
DB_ADMIN_USER=
